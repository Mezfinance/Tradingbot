# Required for the Claude analyst
ANTHROPIC_API_KEY=

# Mode: paper (default) or live. Live needs every LIVE_* value below.
TB_MODE=paper
TB_STARTING_CASH_USD=1000

# Live trading only (Solana). Never commit a real key.
TB_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TB_KEYPAIR_PATH=./keypair.json
# On Fly.io set the key's JSON as a secret instead; the entrypoint writes it to /run/secrets:
# TB_KEYPAIR_JSON=[1,2,3,...]
TB_LIVE_CONFIRM=  # must equal I_ACCEPT_TOTAL_LOSS_RISK to enable live mode
